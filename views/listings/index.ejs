<% layout("/layouts/boilerPlate") %>

<style>
    #filters {
        display: flex;
        overflow-x: auto;
        scroll-behavior: smooth;
        width: 100%;
        padding: 1rem 0;
        scrollbar-width: none;
    }

    #filters::-webkit-scrollbar {
        display: none;
    }

    .filter {
        text-align: center;
        margin: 0 0.4rem;
        min-width: 6rem;
        flex-shrink: 0;
    }

    .filter:hover {
        cursor: pointer;
    }

    .filter i {
        color: black;
        font-size: 2rem;
        transition: color 0.3s ease;
    }

    .filter:hover i {
        color: gray;
    }

    .filter p {
        font-size: 0.8rem;
        color: black;
        margin-top: 0.5rem;
        font-weight: 500;
    }

    .filter a {
        text-decoration: none;
        color: black;
    }

    .filter p:hover {
        color: gray;
        cursor: pointer;
    }

    .tax-info {
        display: none;
    }

    @media (max-width: 768px) {
        #filters {
            justify-content: flex-start;
        }
    }
</style>

<!-- Category Filters -->
<div id="filters">
    <% const categories = [
        { name: 'Trending', icon: 'fa-fire' },
        { name: 'Rooms', icon: 'fa-bed' },
        { name: 'Iconic Cities', icon: 'fa-mountain-city' },
        { name: 'Mountains', icon: 'fa-mountain' },
        { name: 'Castles', icon: 'fa-chess-rook' },
        { name: 'Amazing Pools', icon: 'fa-person-swimming' },
        { name: 'Camping', icon: 'fa-campground' },
        { name: 'Farms', icon: 'fa-cow' },
        { name: 'Arctic', icon: 'fa-snowflake' },
        { name: 'BeachFront', icon: 'fa-umbrella-beach' },
        { name: 'Boats', icon: 'fa-ship' },
    ]; %>
    <% categories.forEach(category => { %>
        <div class="filter">
            <a href="/listings?category=<%= category.name %>">
                <div><i class="fa-solid <%= category.icon %>"></i></div>
                <p><%= category.name %></p>
            </a>
        </div>
    <% }) %>
</div>

<!-- Toggle for Tax -->
<div class="tax-toggle">
    <div class="form-check-reverse form-switch">
        <input 
            class="form-check-input"
            type="checkbox"
            role="switch"
            id="flexSwitchCheckDefault">
        <label 
            class="form-check-label"
            for="flexSwitchCheckDefault">Display total after taxes
        </label>
    </div>
</div>

<!-- Listings -->
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% for (let listing of allListings) { %>
        <a href="/listings/<%= listing._id %>" class="listing-link">
            <div class="card col listing-card">
                <img 
                    src="<%= listing.image.url %>"
                    class="card-img-top"
                    alt="listing_image"
                    style="height: 20rem;">
                <div class="card-img-overlay"></div>
                <div class="card-body" 
                    data-price="<%= listing.price %>" 
                    data-nights="<%= listing.nights %>">
                    <p class="card-text">
                        <b><%= listing.title %></b>
                        <br>&#8377; <%= listing.price.toLocaleString("en-IN") %> /night <br>
                        <b>Number of Nights:</b> <%= listing.nights %> <br>
                        <b>Total Cost:</b> &#8377; <%= (listing.price * listing.nights).toLocaleString("en-IN") %> <br>
                        <b class="tax-info">Total Cost with GST:</b>
                        <span class="tax-info">&#8377; <%= ((listing.price * listing.nights) * 1.18).toLocaleString("en-IN") %></span>
                    </p>
                </div>
            </div>
        </a>
    <% } %>
</div>

<script>
    const taxSwitch = document.getElementById("flexSwitchCheckDefault");

    const updateTaxInfoDisplay = () => {
        const cardBodies = document.querySelectorAll(".card-body");

        cardBodies.forEach(cardBody => {
            const price = parseFloat(cardBody.dataset.price);
            const nights = parseInt(cardBody.dataset.nights);

            const totalWithGST = (price * nights * 1.18).toLocaleString("en-IN");

            const taxInfoElements = cardBody.querySelectorAll(".tax-info");

            if (taxSwitch.checked) {
                if (taxInfoElements.length === 2) {
                    taxInfoElements[1].innerHTML = `&#8377; ${totalWithGST}`;
                }
                taxInfoElements.forEach(el => el.style.display = "inline");
            } else {
                taxInfoElements.forEach(el => el.style.display = "none");
            }
        });
    };

    // Run on page load
    window.onload = updateTaxInfoDisplay;

    // Toggle change
    taxSwitch?.addEventListener("change", () => {
        updateTaxInfoDisplay();
    });
</script>
