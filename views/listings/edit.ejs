<% layout("/layouts/boilerPlate") %>

<div class="row mt-3">
    <div class="col-12 col-md-10 col-lg-8 mx-auto">

        <h3 class="mb-4">
            Edit Listing
        </h3>

        <form
            method="POST"
            action="/listings/<%= listing._id %>?_method=PUT"
            enctype="multipart/form-data"
        >

            <!-- =========================
                 Title
                 ========================= -->

            <div class="mb-3">

                <label
                    for="title"
                    class="form-label"
                >
                    Title
                </label>

                <input
                    type="text"
                    id="title"
                    value="<%= listing.title %>"
                    name="listing[title]"
                    class="form-control"
                    required
                >

                <div class="invalid-feedback">
                    Title should be valid
                </div>

            </div>


            <!-- =========================
                 Description
                 ========================= -->

            <div class="mb-3">

                <label
                    for="description"
                    class="form-label"
                >
                    Description
                </label>

                <textarea
                    name="listing[description]"
                    id="description"
                    class="form-control"
                    rows="5"
                    required
                ><%= listing.description %></textarea>

                <div class="invalid-feedback">
                    Please enter a short description
                </div>

            </div>


            <!-- =========================
                 Original Image
                 ========================= -->

            <div class="mb-3">

                <label class="form-label">
                    Original Image
                </label>

                <br>

                <img
                    src="<%= originalImageUrl %>"
                    alt="Listing Image"
                    class="original-listing-image"
                >

            </div>


            <!-- =========================
                 Upload New Image
                 ========================= -->

            <div class="mb-3">

                <label
                    for="image"
                    class="form-label"
                >
                    Upload New Image
                </label>

                <input
                    type="file"
                    id="image"
                    name="listing[image]"
                    class="form-control"
                >

            </div>


            <!-- =========================
                 Price + Nights
                 ========================= -->

            <div class="row">

                <div class="mb-3 col-12 col-md-6">

                    <label
                        for="price"
                        class="form-label"
                    >
                        Price
                    </label>

                    <input
                        type="number"
                        id="price"
                        value="<%= listing.price %>"
                        name="listing[price]"
                        class="form-control"
                        required
                    >

                    <div class="invalid-feedback">
                        Price should be valid
                    </div>

                </div>


                <div class="mb-3 col-12 col-md-6">

                    <label
                        for="nights"
                        class="form-label"
                    >
                        Nights
                    </label>

                    <input
                        type="number"
                        id="nights"
                        value="<%= listing.nights %>"
                        name="listing[nights]"
                        class="form-control"
                        required
                        min="1"
                    >

                    <div class="invalid-feedback">
                        Nights should be valid
                    </div>

                </div>

            </div>


            <!-- =========================
                 Location + Country
                 ========================= -->

            <div class="row">

                <div class="mb-3 col-12 col-md-6">

                    <label
                        for="location"
                        class="form-label"
                    >
                        Location
                    </label>

                    <input
                        type="text"
                        id="location"
                        value="<%= listing.location %>"
                        name="listing[location]"
                        class="form-control"
                        required
                    >

                    <div class="invalid-feedback">
                        Location should be valid
                    </div>

                </div>


                <div class="mb-3 col-12 col-md-6">

                    <label
                        for="country"
                        class="form-label"
                    >
                        Country
                    </label>

                    <input
                        type="text"
                        id="country"
                        value="<%= listing.country %>"
                        name="listing[country]"
                        class="form-control"
                        required
                    >

                    <div class="invalid-feedback">
                        Country should be valid
                    </div>

                </div>

            </div>


            <!-- =========================
                 Destination
                 ========================= -->

            <div class="mb-3">

                <label
                    for="destination"
                    class="form-label"
                >
                    Destination
                </label>

                <select
                    name="listing[destination]"
                    id="destination"
                    class="form-select"
                    required
                >

                    <option value="">
                        Select Destination
                    </option>

                    <option
                        value="BeachFront"
                        <% if(listing.destination === "BeachFront") { %>
                            selected
                        <% } %>
                    >
                        BeachFront
                    </option>

                    <option
                        value="Mountains"
                        <% if(listing.destination === "Mountains") { %>
                            selected
                        <% } %>
                    >
                        Mountains
                    </option>

                    <option
                        value="Castles"
                        <% if(listing.destination === "Castles") { %>
                            selected
                        <% } %>
                    >
                        Castles
                    </option>

                    <option
                        value="Camping"
                        <% if(listing.destination === "Camping") { %>
                            selected
                        <% } %>
                    >
                        Camping
                    </option>

                    <option
                        value="Farms"
                        <% if(listing.destination === "Farms") { %>
                            selected
                        <% } %>
                    >
                        Farms
                    </option>

                    <option
                        value="Arctic"
                        <% if(listing.destination === "Arctic") { %>
                            selected
                        <% } %>
                    >
                        Arctic
                    </option>

                    <option
                        value="Iconic Cities"
                        <% if(listing.destination === "Iconic Cities") { %>
                            selected
                        <% } %>
                    >
                        Iconic Cities
                    </option>

                    <option
                        value="Rooms"
                        <% if(listing.destination === "Rooms") { %>
                            selected
                        <% } %>
                    >
                        Rooms
                    </option>

                    <option
                        value="Trending"
                        <% if(listing.destination === "Trending") { %>
                            selected
                        <% } %>
                    >
                        Trending
                    </option>

                    <option
                        value="Amazing Pools"
                        <% if(listing.destination === "Amazing Pools") { %>
                            selected
                        <% } %>
                    >
                        Amazing Pools
                    </option>

                    <option
                        value="Boats"
                        <% if(listing.destination === "Boats") { %>
                            selected
                        <% } %>
                    >
                        Boats
                    </option>

                </select>

                <div class="invalid-feedback">
                    Destination should be valid
                </div>

            </div>


            <!-- =========================
                 Edit Button
                 ========================= -->

            <button
                type="submit"
                class="btn btn-dark edit-btn mt-3"
            >
                Edit
            </button>

        </form>

    </div>
</div>