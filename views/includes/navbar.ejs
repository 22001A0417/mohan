<style>
    .navbar {
        background-color: #f8f9fa; 
    }

    .navbar-brand i {
        color: #fe424d; 
        font-size: 1.8rem;
    }

    .search-btn {
        background-color: #fe424d; 
        color: #fff;
        border-radius: 25px;
        padding: 0.3rem 1rem;
        font-size: 0.9rem;
    }

    .search-btn:hover {
        background-color: #d32f2f; 
        color: #fff;
    }

    .search-input {
        border-radius: 25px;
        padding: 0.3rem 0.8rem;
        font-size: 0.9rem;
        border: 1px solid #ced4da; 
        width: auto;
        flex-grow: 1;
    }

    .navbar-nav .nav-link {
        font-size: 0.9rem;
        color: #343a40;
    }

    .navbar-nav .nav-link:hover {
        color: #fe424d; 
    }

    /* Styling for Dropdown Menu (Toggle Content) */
    .collapse .navbar-nav {
        background-color: #333;
        color: white !important;
        border-radius: 5px; 
        padding: 0.5rem; 
    }

    .collapse .navbar-nav .nav-link {
        color: white !important; 
    }

    .collapse .navbar-nav .nav-link:hover {
        background-color: #444; 
        color: #fff !important; 
    }

    /* Responsive Styling for <768px */
    @media (max-width: 768px) {
        .navbar-header {
            display: flex;
            align-items: center;
            justify-content: flex-start;
            width: 100%;
        }

        .navbar-brand {
            margin-right: auto; 
        }

        .navbar-nav-center {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: auto;
            flex-grow: 1;
            margin-left: 0.5rem;
        }

        .navbar-toggler {
            margin-left: auto; 
        }

        .collapse .navbar-nav {
            flex-direction: column;
            text-align: left;
            margin-top: 1rem;
        }
    }

    /* Responsive Styling for <430px */
    @media (max-width: 430px) {
        .search-input {
            width: 60%; 
            padding: 0.2rem 0.5rem; 
            font-size: 0.8rem; 
        }

        .search-btn {
            padding: 0.2rem 0.8rem; 
            font-size: 0.8rem;
        }
    }
</style>

<nav class="navbar navbar-expand-md border-bottom sticky-top">
    <div class="container-fluid">
        <a class="navbar-brand" href="/listings">
            <i class="fa-regular fa-compass"></i>
        </a>

        <div class="navbar-nav navbar-nav-center">
            <form class="d-flex" role="search" action="/listings/search" method="GET">
                <input 
                    class="form-control me-2 search-input" 
                    type="search" 
                    placeholder="Search destinations" 
                    aria-label="Search" 
                    name="query">
                <button class="btn search-btn" type="submit">
                    <i class="fa-solid fa-magnifying-glass"></i> Search
                </button>
            </form>
        </div>

        <button 
            class="navbar-toggler" 
            type="button" 
            data-bs-toggle="collapse" 
            data-bs-target="#navbarNavAltMarkup">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="/listings">Explore</a>
                <a class="nav-link" href="/listings/new">Airbnb your home</a>
                <% if (typeof currUser === "undefined" || !currUser) { %>
                    <a class="nav-link" href="/signup">Sign up</a>
                    <a class="nav-link" href="/login">Log in</a>
                <% } %>

                <% if (typeof currUser !== "undefined" && currUser) { %>
                    <a class="nav-link" href="/logout">Log out</a>
                <% } %>
            </div>
        </div>
    </div>
</nav>